# Claude Code worktrees (created by /proceed for parallel session isolation)
.claude/worktrees/
.worktrees/

# Per-user Claude Code overrides (team settings live in .claude/settings.json)
.claude/settings.local.json

# OS noise
.DS_Store

# AIF pipeline state (ephemeral, per-worktree)
.aif/specs/*/pipeline-state.json

# Python bytecode (tools/ test runs)
__pycache__/
*.pyc
.pytest_cache/

# Per-machine reflection inbox — session-reflect.sh appends here through the
# ~/.claude/aif-references symlink; scratch until promoted to known-warts.md
references/known-warts-inbox.md
