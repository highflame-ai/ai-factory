// Generated by `aif compile` from roles/*.yaml — do not hand-edit.
// One permit per role (envelope semantics) + explicit forbids for
// write:false roles. Agent exceptions are per-principal permits.

// role: reviewer — Read-only analysis of code, diffs, and artifacts. Produces findings reports. Never mutates the working tree.
permit(principal in Role::"reviewer", action in [Action::"ExecuteCommand", Action::"ListFiles", Action::"NetworkRead", Action::"ReadFile", Action::"SearchCode"], resource);
forbid(principal in Role::"reviewer", action == Action::"WriteFile", resource) when { principal != Agent::"gemini-reviewer" };
// exception: gemini-reviewer — applies accepted review-bot comments directly to the working tree
permit(principal == Agent::"gemini-reviewer", action == Action::"WriteFile", resource);

// role: scanner — Scheduled/on-demand scans for optimization opportunities (cost, latency, DB). Findings only.
permit(principal in Role::"scanner", action in [Action::"ExecuteCommand", Action::"ListFiles", Action::"ReadFile", Action::"SearchCode"], resource);
forbid(principal in Role::"scanner", action == Action::"WriteFile", resource);

// role: explorer — Cheap, fast codebase mapping — blast radius, precedents, integration surfaces. Returns structure, not judgments.
permit(principal in Role::"explorer", action in [Action::"ExecuteCommand", Action::"ListFiles", Action::"NetworkRead", Action::"ReadFile", Action::"SearchCode"], resource);
forbid(principal in Role::"explorer", action == Action::"WriteFile", resource);

// role: implementer — Implements one scoped task inside a designated worktree — edits, tests, commits within that boundary.
permit(principal in Role::"implementer", action in [Action::"ExecuteCommand", Action::"ListFiles", Action::"MonitorProcess", Action::"NetworkRead", Action::"ReadFile", Action::"SearchCode", Action::"WriteFile"], resource);

// role: orchestrator — Drives multi-phase pipelines or long-running chores end to end (pipeline runs, PR babysitting, stack/regression lifecycles). May dispatch work and post to configured channels.
permit(principal in Role::"orchestrator", action in [Action::"ExecuteCommand", Action::"ListFiles", Action::"MonitorProcess", Action::"NetworkRead", Action::"NetworkWrite", Action::"ReadFile", Action::"SearchCode", Action::"WriteFile"], resource);
